{
  "name": "@ofc-gm/components",
  "version": "0.1.0",
  "description": "OFC-GM UI: Lit Web Components + React wrappers for signaling",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./lib/react/index.js",
      "default": "./lib/react/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "react": [
        "react.d.ts"
      ]
    }
  },
  "files": [
    "lib",
    "index.d.ts",
    "react.d.ts",
    "readme.md"
  ],
  "sideEffects": [
    "./lib/index.js",
    "./lib/signal-panel.js",
    "./lib/signal-exchange.js",
    "./lib/react/index.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-package-dts.mjs",
    "build:watch": "tsc -p tsconfig.json --watch",
    "clean": "rm -rf lib index.d.ts react.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run clean && pnpm run build",
    "prepublishOnly": "pnpm run build",
    "dev": "vite"
  },
  "keywords": [
    "web-components",
    "lit",
    "react",
    "webrtc",
    "signaling",
    "ofc-gm"
  ],
  "author": "ranmeizi",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranmeizi/ofc-gm.git",
    "directory": "packages/components"
  },
  "homepage": "https://ranmeizi.github.io/ofc-gm/",
  "bugs": {
    "url": "https://github.com/ranmeizi/ofc-gm/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@ofc-gm/framework": "workspace:^",
    "lit": "^3.2.0"
  },
  "peerDependencies": {
    "@types/react": ">=17.0.0",
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
