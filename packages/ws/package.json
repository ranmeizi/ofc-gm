{
  "name": "@ofc-gm/ws",
  "version": "0.1.0",
  "description": "WebSocket signaling relay for OFC-GM PeerConnection SDP exchange",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "files": [
    "dist",
    "ecosystem.config.cjs",
    "README.md"
  ],
  "bin": {
    "ofc-signal-ws": "./dist/cli.js",
    "ofc-gm-ws": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ofc-signal-ws",
    "pm2:logs": "pm2 logs ofc-signal-ws"
  },
  "keywords": [
    "websocket",
    "webrtc",
    "signaling",
    "sdp",
    "pm2",
    "ofc-gm"
  ],
  "author": "ranmeizi",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranmeizi/ofc-gm.git",
    "directory": "packages/ws"
  },
  "homepage": "https://github.com/ranmeizi/ofc-gm/tree/main/packages/ws",
  "bugs": {
    "url": "https://github.com/ranmeizi/ofc-gm/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
