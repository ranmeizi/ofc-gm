{
  "name": "@ofc-gm/framework",
  "version": "1.0.0",
  "description": "Office WebRTC mini-game framework — PeerConnection, Room, startHost",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --config vite.lib.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "dev:playground": "vite",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "datachannel",
    "game",
    "ofc-gm"
  ],
  "author": "ranmeizi",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranmeizi/ofc-gm.git",
    "directory": "packages/framework"
  },
  "homepage": "https://ranmeizi.github.io/ofc-gm/",
  "bugs": {
    "url": "https://github.com/ranmeizi/ofc-gm/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/simple-peer": "^9.11.9",
    "buffer": "^6.0.3",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "simple-peer": "^9.11.1"
  }
}
